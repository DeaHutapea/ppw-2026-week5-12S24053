			"key": "base_url",
			"value": "http://localhost:8000/api/v1",
			"type": "string"
		},
		{
			"key": "soap_url",
			"value": "http://localhost:8000/soap",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "created_buku_id",
			"value": "1",
			"type": "string"
		},
